{
  "expo": {
    "name": "LiveCircle",
    "slug": "livecircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "livecircle",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.livecircle.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "LiveCircle requires your location to display you on the live circle map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LiveCircle uses your background location to alert circle members when you enter or leave designated geofences.",
        "NSLocationAlwaysUsageDescription": "LiveCircle uses your background location to alert circle members when you enter or leave designated geofences."
      }
    },
    "android": {
      "package": "com.livecircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LiveCircle requires background location to alert your circle when you enter or leave designated geofences.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3158D8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8fd1f2a-0e44-4e0a-91d2-dd646aa6b129"
      }
    },
    "owner": "tasavvuf"
  }
}
